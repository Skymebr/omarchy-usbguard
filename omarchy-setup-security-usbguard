#!/bin/bash
# omarchy:summary=Set up and configure USBGuard hardware protection
# omarchy:args=[--yes] [--regenerate-policy] [--remove] [--user <name>]
# omarchy:examples=omarchy setup security usbguard | omarchy-setup-security-usbguard --remove
# omarchy:requires-sudo=true

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_CONF="/etc/usbguard/usbguard-daemon.conf"
RULES_FILE="/etc/usbguard/rules.conf"
IPC_DIR="/etc/usbguard/IPCAccessControl.d"
STATE_FILE="/etc/usbguard/.omarchy-state.json"

ASSUME_YES=0
REGENERATE=0
REMOVE=0

# Determine real target user even when executed via sudo
RAW_USER="${SUDO_USER:-${USER:-$(id -un)}}"
if [[ "$RAW_USER" == "root" && -n "${SUDO_USER:-}" ]]; then
  RAW_USER="$SUDO_USER"
fi

usage() {
  cat <<'USAGE'
Usage: omarchy-setup-security-usbguard [OPTIONS]

Options:
  -y, --yes              Skip interactive confirmation prompt
  --regenerate-policy    Rebuild rules.conf from currently connected devices (with backup)
  --remove               Clean rollback and removal of USBGuard configuration and services
  --user <name>          Specific user to authorize for IPC (defaults to current user)
  -h, --help             Show this help message
USAGE
}

while (($# > 0)); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --regenerate-policy)
    REGENERATE=1
    shift
    ;;
  --remove)
    REMOVE=1
    shift
    ;;
  --user)
    RAW_USER="${2:-}"
    [[ -n "$RAW_USER" ]] || { echo "Error: --user requires a username argument" >&2; exit 1; }
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage
    exit 1
    ;;
  esac
done

# ------------------------------------------------------------------------------
# 1. RIGOROUS CANONICAL USER VALIDATION (Point 1)
# ------------------------------------------------------------------------------
# Reject path separators, dots, leading hyphens, or non-POSIX username chars
if [[ ! "$RAW_USER" =~ ^[a-z_][a-z0-9_-]*\$?$ ]]; then
  echo "Error: Invalid username format '${RAW_USER}'. Usernames must be canonical POSIX account names." >&2
  exit 1
fi

PWENT=$(getent passwd "$RAW_USER" || true)
if [[ -z "$PWENT" ]]; then
  echo "Error: User '${RAW_USER}' does not exist in the system user database." >&2
  exit 1
fi

TARGET_USER=$(printf '%s' "$PWENT" | cut -d: -f1)
TARGET_UID=$(printf '%s' "$PWENT" | cut -d: -f3)
TARGET_HOME=$(printf '%s' "$PWENT" | cut -d: -f6)

if [[ -z "$TARGET_HOME" || ! -d "$TARGET_HOME" || -L "$TARGET_HOME" ]]; then
  echo "Error: Home directory for user '${TARGET_USER}' is invalid or a symlink." >&2
  exit 1
fi

USER_BIN_DIR="${TARGET_HOME}/.local/bin"
SYSTEMD_USER_DIR="${TARGET_HOME}/.config/systemd/user"
USER_RUNTIME_DIR="/run/user/${TARGET_UID}"

# Ensure safe, owner-only directory without symlinks (Point 3)
ensure_safe_user_dir() {
  local dir="$1"
  local expected_uid="$2"
  if [[ -L "$dir" ]]; then
    echo "Error: Destination directory '${dir}' is a symbolic link. Aborting for security." >&2
    exit 1
  fi
  if [[ -e "$dir" ]]; then
    local owner
    owner=$(stat -c '%u' "$dir" 2>/dev/null || echo "-1")
    if [[ "$owner" != "$expected_uid" && "$owner" != "0" ]]; then
      echo "Error: Destination directory '${dir}' is owned by UID ${owner}, expected ${expected_uid}." >&2
      exit 1
    fi
  else
    sudo -u "$TARGET_USER" mkdir -p "$dir"
    chmod 0755 "$dir"
  fi
}

# Descriptor-relative safe IPC removal (Point 1)
safe_remove_user_ipc() {
  local user="$1"
  if [[ -d "$IPC_DIR" && ! -L "$IPC_DIR" ]]; then
    local clean_name="${user##*/}"
    if [[ "$clean_name" == "$user" && -f "${IPC_DIR}/${user}" && ! -L "${IPC_DIR}/${user}" ]]; then
      rm -f "${IPC_DIR}/${user}"
    fi
  fi
}

# ==============================================================================
# ROLLBACK / REMOVAL (Point 2: Non-destructive transactional restoration)
# ==============================================================================
if (( REMOVE )); then
  echo "==> 1. Stopping and disabling user notification service..."
  if [[ -S "${USER_RUNTIME_DIR}/bus" ]]; then
    sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user stop omarchy-usbguard-notify.service 2>/dev/null || true
    sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user disable omarchy-usbguard-notify.service 2>/dev/null || true
    sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user daemon-reload 2>/dev/null || true
  fi
  if [[ -f "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service" && ! -L "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service" ]]; then
    rm -f "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service"
  fi

  # Read state manifest to determine what was inherited vs created
  WAS_ACTIVE=0
  WAS_ENABLED=0
  HAD_RULES=0
  HAD_DAEMON_CONF=0

  if [[ -f "$STATE_FILE" && ! -L "$STATE_FILE" ]]; then
    WAS_ACTIVE=$(grep -o '"was_service_active": [01]' "$STATE_FILE" | awk '{print $2}' || echo 0)
    WAS_ENABLED=$(grep -o '"was_service_enabled": [01]' "$STATE_FILE" | awk '{print $2}' || echo 0)
    HAD_RULES=$(grep -o '"had_rules": [01]' "$STATE_FILE" | awk '{print $2}' || echo 0)
    HAD_DAEMON_CONF=$(grep -o '"had_daemon_conf": [01]' "$STATE_FILE" | awk '{print $2}' || echo 0)
  fi

  echo "==> 2. Restoring system service state..."
  # If USBGuard was NOT active/enabled before this plugin installed it, disable and stop it
  if (( ! WAS_ACTIVE )); then
    systemctl stop usbguard.service 2>/dev/null || true
  fi
  if (( ! WAS_ENABLED )); then
    systemctl disable usbguard.service 2>/dev/null || true
  fi

  echo "==> 3. Restoring configuration files safely..."
  # Restore rules.conf
  if (( HAD_RULES )) && [[ -f "${RULES_FILE}.omarchy-orig" && ! -L "${RULES_FILE}.omarchy-orig" ]]; then
    echo "  Restoring original pre-existing rules.conf..."
    install -m 0600 -o root -g root "${RULES_FILE}.omarchy-orig" "$RULES_FILE"
    rm -f "${RULES_FILE}.omarchy-orig"
  elif (( ! HAD_RULES )) && [[ -f "$RULES_FILE" && ! -L "$RULES_FILE" ]]; then
    echo "  Removing plugin-generated rules.conf..."
    rm -f "$RULES_FILE"
  fi

  # Restore daemon.conf
  if (( HAD_DAEMON_CONF )) && [[ -f "${DAEMON_CONF}.omarchy-orig" && ! -L "${DAEMON_CONF}.omarchy-orig" ]]; then
    echo "  Restoring original pre-existing daemon configuration..."
    install -m 0600 -o root -g root "${DAEMON_CONF}.omarchy-orig" "$DAEMON_CONF"
    rm -f "${DAEMON_CONF}.omarchy-orig"
  fi

  # Safe removal of IPC rule
  safe_remove_user_ipc "$TARGET_USER"

  # Clean state file
  rm -f "$STATE_FILE"
  systemctl daemon-reload 2>/dev/null || true

  echo "==> 4. Removing installed user binaries..."
  if [[ -d "$USER_BIN_DIR" && ! -L "$USER_BIN_DIR" ]]; then
    for bin in omarchy-usbguard-watch omarchy-usbguard-event omarchy-usbguard-prompt \
               omarchy-usbguard-allow omarchy-usbguard-manage omarchy-usbguard-lib \
               omarchy-setup-security-usbguard omarchy-setup-usbguard; do
      if [[ -f "${USER_BIN_DIR}/${bin}" || -L "${USER_BIN_DIR}/${bin}" ]]; then
        rm -f "${USER_BIN_DIR}/${bin}"
      fi
    done
  fi

  echo "==> USBGuard hardware protection integration successfully removed."
  exit 0
fi

# ==============================================================================
# CONFIRMATION & SAFETY BANNER
# ==============================================================================
if (( ! ASSUME_YES )); then
  cat <<'BANNER'
================================================================================
                    🛡️  OMARCHY USBGUARD SETUP
================================================================================
USBGuard blocks unauthorized USB devices at the Linux Kernel level.
If configured without vital peripherals attached, it could block your keyboard.

IMPORTANT:
1. Ensure your KEYBOARD, MOUSE, DOCK, WEBCAM and all vital hardware are
   PLUGGED IN RIGHT NOW before proceeding.
2. Keep a wired keyboard attached while completing setup.
================================================================================
BANNER
  read -r -p "Do you want to proceed with USBGuard installation? [y/N] " response
  if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
    echo "Aborted by user."
    exit 0
  fi
fi

# ==============================================================================
# TRANSACTIONAL STATE CAPTURE & INSTALLATION (Point 2 & Point 3)
# ==============================================================================
echo "==> 1. Checking for usbguard package..."
if ! pacman -Q usbguard &>/dev/null; then
  pacman -S --noconfirm --needed usbguard
fi

echo "==> 2. Capturing pre-existing system state..."
mkdir -p /etc/usbguard
chmod 0755 /etc/usbguard

WAS_SERVICE_ACTIVE=0
WAS_SERVICE_ENABLED=0
HAD_RULES=0
HAD_DAEMON_CONF=0

if systemctl is-active --quiet usbguard.service 2>/dev/null; then
  WAS_SERVICE_ACTIVE=1
fi
if systemctl is-enabled --quiet usbguard.service 2>/dev/null; then
  WAS_SERVICE_ENABLED=1
fi
if [[ -f "$RULES_FILE" && ! -L "$RULES_FILE" ]]; then
  HAD_RULES=1
  if [[ ! -f "${RULES_FILE}.omarchy-orig" ]]; then
    install -m 0600 -o root -g root "$RULES_FILE" "${RULES_FILE}.omarchy-orig"
  fi
fi
if [[ -f "$DAEMON_CONF" && ! -L "$DAEMON_CONF" ]]; then
  HAD_DAEMON_CONF=1
  if [[ ! -f "${DAEMON_CONF}.omarchy-orig" ]]; then
    install -m 0600 -o root -g root "$DAEMON_CONF" "${DAEMON_CONF}.omarchy-orig"
  fi
fi

# Write state atomically
cat <<EOF > "${STATE_FILE}.tmp"
{
  "target_user": "${TARGET_USER}",
  "was_service_active": ${WAS_SERVICE_ACTIVE},
  "was_service_enabled": ${WAS_SERVICE_ENABLED},
  "had_rules": ${HAD_RULES},
  "had_daemon_conf": ${HAD_DAEMON_CONF},
  "installed_at": $(date +%s)
}
EOF
install -m 0600 -o root -g root "${STATE_FILE}.tmp" "$STATE_FILE"
rm -f "${STATE_FILE}.tmp"

echo "==> 3. Generating hardware whitelist policy..."
if [[ ! -f "$RULES_FILE" ]] || (( REGENERATE )); then
  TMP_RULES=$(mktemp /tmp/rules.conf.XXXXXX)
  chmod 0600 "$TMP_RULES"
  
  # 1. Always auto-allow internal hardwired peripherals
  echo 'allow with-connect-type "hardwired"' > "$TMP_RULES"
  
  # 2. Append generated policy for currently connected devices
  usbguard generate-policy >> "$TMP_RULES"
  
  # Atomically install verified rules file
  install -m 0600 -o root -g root "$TMP_RULES" "$RULES_FILE"
  rm -f "$TMP_RULES"
fi

echo "==> 4. Configuring daemon anti-lockout policy..."
if [[ -f "$DAEMON_CONF" && ! -L "$DAEMON_CONF" ]]; then
  if grep -q '^PresentDevicePolicy=' "$DAEMON_CONF"; then
    sed -i -E 's/^PresentDevicePolicy=.*/PresentDevicePolicy=keep/' "$DAEMON_CONF"
  elif grep -q '^[#[:space:]]*PresentDevicePolicy=' "$DAEMON_CONF"; then
    sed -i -E 's/^[#[:space:]]*PresentDevicePolicy=.*/PresentDevicePolicy=keep/' "$DAEMON_CONF"
  else
    echo "PresentDevicePolicy=keep" >> "$DAEMON_CONF"
  fi
fi

echo "==> 5. Configuring IPC permissions for user '${TARGET_USER}'..."
mkdir -p "$IPC_DIR"
chmod 0755 "$IPC_DIR"
safe_remove_user_ipc "$TARGET_USER"
usbguard add-user -u "$TARGET_USER" -d modify,list,listen -p modify,list -e listen -P listen

echo "==> 6. Installing binaries to ${USER_BIN_DIR} (no-follow, atomic)..."
ensure_safe_user_dir "$USER_BIN_DIR" "$TARGET_UID"

for bin in omarchy-usbguard-watch omarchy-usbguard-event omarchy-usbguard-prompt \
           omarchy-usbguard-allow omarchy-usbguard-manage omarchy-usbguard-lib \
           omarchy-setup-security-usbguard; do
  install -m 0755 -o "$TARGET_UID" -g "$TARGET_UID" "${SCRIPT_DIR}/${bin}" "${USER_BIN_DIR}/${bin}"
done

# Safe symlink alias
rm -f "${USER_BIN_DIR}/omarchy-setup-usbguard"
ln -s "omarchy-setup-security-usbguard" "${USER_BIN_DIR}/omarchy-setup-usbguard"
chown -h "${TARGET_UID}:${TARGET_UID}" "${USER_BIN_DIR}/omarchy-setup-usbguard" 2>/dev/null || true

echo "==> 7. Setting up systemd user notification service..."
ensure_safe_user_dir "$SYSTEMD_USER_DIR" "$TARGET_UID"

TMP_UNIT=$(mktemp /tmp/usbguard-unit.XXXXXX)
cat << 'EOF' > "$TMP_UNIT"
[Unit]
Description=Omarchy USBGuard Notification Watcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/omarchy-usbguard-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF

install -m 0644 -o "$TARGET_UID" -g "$TARGET_UID" "$TMP_UNIT" "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service"
rm -f "$TMP_UNIT"

echo "==> 8. Starting system and user services..."
systemctl enable --now usbguard.service
systemctl restart usbguard.service

if [[ -S "${USER_RUNTIME_DIR}/bus" ]]; then
  sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user daemon-reload || true
  sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user enable --now omarchy-usbguard-notify.service || true
  sudo -u "$TARGET_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus" XDG_RUNTIME_DIR="${USER_RUNTIME_DIR}" systemctl --user restart omarchy-usbguard-notify.service || true
fi

echo "==> Success! USBGuard hardware protection is active and integrated with Omarchy Shell."


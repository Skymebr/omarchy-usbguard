#!/bin/bash
# omarchy:summary=Set up and configure USBGuard hardware protection
# omarchy:args=[--yes] [--regenerate-policy] [--remove] [--user <name>]
# omarchy:examples=omarchy setup security usbguard | omarchy-setup-security-usbguard --remove
# omarchy:requires-sudo=true

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_BIN_DIR="${HOME}/.local/bin"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"
DAEMON_CONF="/etc/usbguard/usbguard-daemon.conf"
RULES_FILE="/etc/usbguard/rules.conf"

ASSUME_YES=0
REGENERATE=0
REMOVE=0
TARGET_USER="${SUDO_USER:-${USER:-$(id -un)}}"

usage() {
  cat <<'USAGE'
Usage: omarchy-setup-security-usbguard [OPTIONS]

Options:
  -y, --yes              Skip interactive confirmation prompt
  --regenerate-policy    Rebuild rules.conf from currently connected devices (with backup)
  --remove               Clean rollback and removal of USBGuard configuration and services
  --user <name>          Specific user to authorize for IPC (defaults to current user)
  -h, --help             Show this help message
USAGE
}

while (($# > 0)); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --regenerate-policy)
    REGENERATE=1
    shift
    ;;
  --remove)
    REMOVE=1
    shift
    ;;
  --user)
    TARGET_USER="${2:-}"
    [[ -n "$TARGET_USER" ]] || { echo "Error: --user requires a username" >&2; exit 1; }
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage
    exit 1
    ;;
  esac
done

# ==============================================================================
# ROLLBACK / REMOVAL
# ==============================================================================
if (( REMOVE )); then
  echo "==> 1. Stopping and disabling user notification service..."
  systemctl --user stop omarchy-usbguard-notify.service 2>/dev/null || true
  systemctl --user disable omarchy-usbguard-notify.service 2>/dev/null || true
  rm -f "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service"

  echo "==> 2. Stopping and disabling system usbguard service..."
  sudo systemctl stop usbguard.service 2>/dev/null || true
  sudo systemctl disable usbguard.service 2>/dev/null || true

  echo "==> 3. Backing up and cleaning configuration..."
  if [[ -f "$RULES_FILE" ]]; then
    sudo cp -f "$RULES_FILE" "${RULES_FILE}.bak.$(date +%s)"
    sudo rm -f "$RULES_FILE"
  fi
  sudo rm -f "/etc/usbguard/IPCAccessControl.d/${TARGET_USER}"

  echo "==> 4. Removing installed user binaries..."
  rm -f "${USER_BIN_DIR}/omarchy-usbguard-watch" \
        "${USER_BIN_DIR}/omarchy-usbguard-event" \
        "${USER_BIN_DIR}/omarchy-usbguard-prompt" \
        "${USER_BIN_DIR}/omarchy-usbguard-allow" \
        "${USER_BIN_DIR}/omarchy-setup-security-usbguard" \
        "${USER_BIN_DIR}/omarchy-setup-usbguard"

  echo "==> USBGuard hardware protection successfully removed."
  exit 0
fi

# ==============================================================================
# CONFIRMATION & SAFETY BANNER
# ==============================================================================
if (( ! ASSUME_YES )); then
  cat <<'BANNER'
================================================================================
                    🛡️  OMARCHY USBGUARD SETUP
================================================================================
USBGuard blocks unauthorized USB devices at the Linux Kernel level.
If configured without vital peripherals attached, it could block your keyboard.

IMPORTANT:
1. Ensure your KEYBOARD, MOUSE, DOCK, WEBCAM and all vital hardware are
   PLUGGED IN RIGHT NOW before proceeding.
2. Keep a wired keyboard attached while completing setup.
================================================================================
BANNER
  read -r -p "Do you want to proceed with USBGuard installation? [y/N] " response
  if [[ ! "$response" =~ ^[yY]([eE][sS])?$ ]]; then
    echo "Aborted by user."
    exit 0
  fi
fi

# ==============================================================================
# INSTALLATION & POLICY GENERATION
# ==============================================================================
echo "==> 1. Checking for usbguard package..."
if ! pacman -Q usbguard &>/dev/null; then
  sudo pacman -S --noconfirm --needed usbguard
fi

echo "==> 2. Generating hardware whitelist policy..."
if [[ ! -f "$RULES_FILE" ]] || (( REGENERATE )); then
  if [[ -f "$RULES_FILE" ]]; then
    sudo cp -f "$RULES_FILE" "${RULES_FILE}.bak.$(date +%s)"
  fi

  # Create empty 0600 rules file securely
  sudo install -m 0600 -o root -g root /dev/null "$RULES_FILE"

  # 1. Always auto-allow internal hardwired peripherals (internal webcams, Bluetooth radios, fingerprint readers)
  echo 'allow with-connect-type "hardwired"' | sudo tee "$RULES_FILE" >/dev/null

  # 2. Append generated policy for currently connected hotplug devices
  sudo usbguard generate-policy | sudo tee -a "$RULES_FILE" >/dev/null
fi

echo "==> 3. Configuring daemon anti-lockout policy..."
if [[ -f "$DAEMON_CONF" ]]; then
  # Ensure PresentDevicePolicy=keep so existing devices are kept safe across daemon restarts
  sudo sed -i -E 's/^PresentDevicePolicy=.*/PresentDevicePolicy=keep/' "$DAEMON_CONF"
fi

echo "==> 4. Configuring IPC permissions for user '${TARGET_USER}'..."
sudo usbguard add-user -u "$TARGET_USER" -d modify,list,listen -p modify,list -e listen -P listen

echo "==> 5. Installing scripts to ${USER_BIN_DIR}..."
mkdir -p "${USER_BIN_DIR}"
cp -f "${SCRIPT_DIR}/omarchy-usbguard-watch" "${USER_BIN_DIR}/"
cp -f "${SCRIPT_DIR}/omarchy-usbguard-event" "${USER_BIN_DIR}/"
cp -f "${SCRIPT_DIR}/omarchy-usbguard-prompt" "${USER_BIN_DIR}/"
cp -f "${SCRIPT_DIR}/omarchy-usbguard-allow" "${USER_BIN_DIR}/"
cp -f "${SCRIPT_DIR}/omarchy-setup-security-usbguard" "${USER_BIN_DIR}/"
ln -sf "${USER_BIN_DIR}/omarchy-setup-security-usbguard" "${USER_BIN_DIR}/omarchy-setup-usbguard"
chmod +x "${USER_BIN_DIR}"/omarchy-usbguard-* "${USER_BIN_DIR}"/omarchy-setup-*

echo "==> 6. Setting up systemd user notification service..."
mkdir -p "${SYSTEMD_USER_DIR}"
cat << 'EOF' > "${SYSTEMD_USER_DIR}/omarchy-usbguard-notify.service"
[Unit]
Description=Omarchy USBGuard Notification Watcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/omarchy-usbguard-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF

echo "==> 7. Enabling and starting system and user services..."
sudo systemctl enable --now usbguard.service
sudo systemctl restart usbguard.service

systemctl --user daemon-reload
systemctl --user enable --now omarchy-usbguard-notify.service
systemctl --user restart omarchy-usbguard-notify.service

echo "==> Success! USBGuard hardware protection is active and integrated with Omarchy Shell."

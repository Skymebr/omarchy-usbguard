#!/bin/bash
# omarchy:summary=USBGuard watcher daemon delegating events to omarchy-usbguard-event via -e

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVENT_HANDLER="${SCRIPT_DIR}/omarchy-usbguard-event"

if [[ ! -x "$EVENT_HANDLER" ]]; then
  EVENT_HANDLER="$(command -v omarchy-usbguard-event || true)"
fi

if [[ -z "$EVENT_HANDLER" || ! -x "$EVENT_HANDLER" ]]; then
  echo "Error: Event handler omarchy-usbguard-event not found or not executable" >&2
  exit 1
fi

exec usbguard watch -w -e "$EVENT_HANDLER"

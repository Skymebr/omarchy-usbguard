#!/bin/bash
# Shared helpers for omarchy-usbguard-*. Sourced, not executed.
# Device-supplied strings (iProduct, iSerial) are attacker-controlled.

ug_sanitize() {
  local text="${1-}" limit="${2:-96}"
  text="${text//$'\r'/ }"
  text="${text//$'\n'/ }"
  text="${text//$'\t'/ }"
  local i char out=""
  local -i n=${#text}
  for ((i = 0; i < n; i++)); do
    char="${text:i:1}"
    if [[ "$char" < $'\x20' || "$char" == $'\x7f' ]]; then
      out+=" "
    else
      out+="$char"
    fi
  done
  out="${out//  / }"
  out="${out#"${out%%[![:space:]]*}"}"
  out="${out%"${out##*[![:space:]]}"}"
  if ((${#out} > limit)); then
    out="${out:0:limit-1}…"
  fi
  printf '%s' "$out"
}

# Never hand a leading-dash string to a command line as a positional.
ug_safe_arg() {
  local text
  text="$(ug_sanitize "${1-}" "${2:-64}")"
  while [[ "$text" == -* ]]; do
    text="${text#-}"
  done
  text="${text#"${text%%[![:space:]]*}"}"
  if [[ -z "$text" ]]; then
    printf '%s' "-"
  else
    printf '%s' "$text"
  fi
}

ug_is_device_id() {
  [[ "${1-}" =~ ^[0-9]+$ ]]
}

ug_is_hash() {
  local h="${1-}"
  [[ "$h" =~ ^[A-Za-z0-9+/=]+$ ]] && ((${#h} >= 16 && ${#h} <= 128))
}

# Attribute whose value is a quoted string. Requires a token boundary so
# `hash` does not match `parent-hash`.
ug_extract_quoted() {
  local key="$1" rule="${2-}"
  if [[ "$rule" =~ (^|[[:space:]])${key}[[:space:]]+\"([^\"]*)\" ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
  fi
}

ug_extract_vidpid() {
  local rule="${1-}"
  if [[ "$rule" =~ (^|[[:space:]])id[[:space:]]+([0-9a-fA-F]{4}:[0-9a-fA-F]{4}) ]]; then
    printf '%s' "${BASH_REMATCH[2],,}"
  fi
}

# Space-separated interface codes, braces optional.
ug_extract_interfaces() {
  local rule="${1-}"
  if [[ "$rule" =~ with-interface[[:space:]]+\{([^}]*)\} ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$rule" =~ with-interface[[:space:]]+([0-9a-fA-F:]+) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

ug_extract_connect_type() {
  ug_extract_quoted "with-connect-type" "${1-}"
}

ug_class_name() {
  local code="${1,,}"
  local head="${code%%:*}"
  case "$head" in
  01) printf '%s' "Audio" ;;
  02) printf '%s' "Communications" ;;
  03) printf '%s' "HID" ;;
  07) printf '%s' "Printer" ;;
  08) printf '%s' "Mass storage" ;;
  09) printf '%s' "Hub" ;;
  0a) printf '%s' "CDC data" ;;
  0b) printf '%s' "Smart card" ;;
  0e) printf '%s' "Video" ;;
  e0) printf '%s' "Wireless" ;;
  *) printf '%s' "" ;;
  esac
}

# Prints: type|glyph|combo|classes
# Classification is by USB interface class, never by iProduct (names lie).
ug_classify() {
  local ifaces="${1-}"
  local has_storage=0 has_hid=0 has_kbd=0 has_mouse=0
  local has_audio=0 has_video=0 has_net=0 has_wireless=0 has_hub=0
  local code head proto
  local -a extras=()

  for code in $ifaces; do
    code="${code,,}"
    head="${code%%:*}"
    proto="${code#*:}"
    case "$head" in
    08) has_storage=1 ;;
    03)
      has_hid=1
      [[ "$proto" == "01:01" ]] && has_kbd=1
      [[ "$proto" == "01:02" ]] && has_mouse=1
      ;;
    01) has_audio=1 ;;
    0e) has_video=1 ;;
    02 | 0a) has_net=1 ;;
    e0) has_wireless=1 ;;
    09) has_hub=1 ;;
    *)
      local label
      label="$(ug_class_name "$code")"
      if [[ -n "$label" ]]; then
        extras+=("$label")
      fi
      ;;
    esac
  done

  local combo=0
  if ((has_storage && has_hid)); then
    combo=1
  fi

  local -a classes=()
  ((has_storage)) && classes+=("Mass storage")
  if ((combo)); then
    classes+=("HID")
  else
    ((has_kbd)) && classes+=("Keyboard")
    ((has_mouse)) && classes+=("Mouse")
    if ((has_hid && !has_kbd && !has_mouse)); then
      classes+=("HID")
    fi
  fi
  ((has_audio)) && classes+=("Audio")
  ((has_video)) && classes+=("Video")
  ((has_net)) && classes+=("Communications")
  ((has_wireless)) && classes+=("Wireless")
  ((has_hub)) && classes+=("Hub")
  local extra
  for extra in "${extras[@]+"${extras[@]}"}"; do
    local seen=0 c
    for c in "${classes[@]+"${classes[@]}"}"; do
      [[ "$c" == "$extra" ]] && seen=1 && break
    done
    ((seen)) || classes+=("$extra")
  done

  local joined="Peripheral"
  if ((${#classes[@]} > 0)); then
    local IFS=" · "
    joined="${classes[*]}"
  fi

  local glyph="󰚥"
  if ((has_storage)); then
    glyph="󰋊"
  elif ((has_kbd || (has_hid && !has_mouse))); then
    glyph=""
  elif ((has_mouse)); then
    glyph="󰍽"
  elif ((has_audio)); then
    glyph="󰋋"
  elif ((has_video)); then
    glyph="󰄀"
  elif ((has_net)); then
    glyph="󰖩"
  elif ((has_wireless)); then
    glyph="󰂯"
  fi

  printf '%s|%s|%s|%s' "$joined" "$glyph" "$combo" "$joined"
}

ug_is_generic_name() {
  local n="${1,,}"
  case "$n" in
  "" | "usb device" | "mass storage" | "generic" | "unknown" | "-" | "usb") return 0 ;;
  esac
  return 1
}

ug_resolve_name() {
  local vid_pid="$1" raw_name="$2"
  local name resolved=""
  name="$(ug_sanitize "$raw_name" 64)"

  if [[ -n "$vid_pid" ]] && ug_is_generic_name "$name"; then
    resolved="$(lsusb -d "$vid_pid" 2>/dev/null | sed -E 's/.*ID [0-9a-fA-F:]+ //' | head -n1 || true)"
    resolved="$(ug_sanitize "$resolved" 64)"
  fi

  if [[ -n "$resolved" ]] && ! ug_is_generic_name "$resolved"; then
    printf '%s' "$resolved"
  elif [[ -n "$name" ]] && ! ug_is_generic_name "$name"; then
    printf '%s' "$name"
  elif [[ -n "$resolved" ]]; then
    printf '%s' "$resolved"
  elif [[ -n "$name" ]]; then
    printf '%s' "$name"
  else
    printf '%s' "USB device"
  fi
}

ug_replace_id() {
  local key="${1-}"
  if [[ -z "$key" ]]; then
    printf '%s' "9876"
    return
  fi
  local n
  n="$(printf '%s' "$key" | cksum | awk '{print $1}')"
  printf '%s' "$((n % 2000000000 + 10000))"
}

ug_is_boring_device() {
  local classes="${1-}" name="${2-}"
  [[ "$classes" == "Hub" ]] && return 0
  [[ "$name" == *"Host Controller"* ]] && return 0
  return 1
}

# Look up the live usbguard numeric id for a device hash. Ids are recycled;
# the hash is the stable identity.
ug_find_id_by_hash() {
  local want="$1" line id
  ug_is_hash "$want" || return 1
  while IFS= read -r line; do
    case "$line" in
    *"hash \"${want}\""*)
      id="${line%%:*}"
      id="${id//[[:space:]]/}"
      ug_is_device_id "$id" || return 1
      printf '%s' "$id"
      return 0
      ;;
    esac
  done < <(usbguard list-devices 2>/dev/null)
  return 1
}

# Resolve a (possibly stale) numeric id against an optional hash.
# Prints the id to use, or empty if the device is gone and no permanent rule
# can be written from the hash alone.
ug_resolve_live_id() {
  local id="${1-}" hash="${2-}"
  local live=""
  if ug_is_hash "$hash"; then
    live="$(ug_find_id_by_hash "$hash" || true)"
    if [[ -n "$live" ]]; then
      printf '%s' "$live"
      return 0
    fi
    return 1
  fi
  if ug_is_device_id "$id"; then
    printf '%s' "$id"
    return 0
  fi
  return 1
}

ug_apply() {
  local verb="$1" id="${2-}" hash="${3-}" permanent="${4:-0}"
  case "$verb" in
  allow | block | reject) ;;
  *)
    echo "ug_apply: unknown verb $verb" >&2
    return 1
    ;;
  esac

  local live=""
  if live="$(ug_resolve_live_id "$id" "$hash")"; then
    if [[ "$permanent" == "1" ]]; then
      usbguard "${verb}-device" -p "$live"
    else
      usbguard "${verb}-device" "$live"
    fi
    return
  fi

  if [[ "$permanent" == "1" ]] && ug_is_hash "$hash" && [[ "$verb" == "allow" ]]; then
    usbguard allow-device -p "allow hash \"${hash}\""
    return
  fi

  echo "Device is no longer present (id=${id:-?} hash=${hash:-?})." >&2
  return 1
}

ug_debounce() {
  local raw_key="${1-}" window_s="${2:-2}"
  local key
  key="$(printf '%s' "$raw_key" | tr -cd 'a-zA-Z0-9_-')"
  [[ -z "$key" ]] && key="default"

  local base_dir="${XDG_RUNTIME_DIR:-}"
  if [[ -z "$base_dir" || ! -d "$base_dir" || -L "$base_dir" ]]; then
    base_dir="/tmp/omarchy-ug-$(id -u)"
  fi

  local dir="${base_dir}/omarchy-usbguard"
  if [[ -L "$dir" ]]; then
    return 0
  fi

  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir" 2>/dev/null || return 0
    chmod 0700 "$dir" 2>/dev/null || true
  fi

  # Validate owner
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || echo "-1")
  if [[ "$owner" != "$(id -u)" ]]; then
    return 0
  fi

  local file="$dir/last-${key}"
  if [[ -L "$file" ]]; then
    rm -f "$file" 2>/dev/null || true
  fi

  local now last=0
  now="$(date +%s)"
  if [[ -f "$file" ]]; then
    last="$(head -n 1 "$file" 2>/dev/null || echo 0)"
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
  fi

  if ((now - last < window_s)); then
    return 1
  fi

  local tmpfile="${file}.tmp.$$"
  if printf '%s\n' "$now" >"$tmpfile" 2>/dev/null; then
    chmod 0600 "$tmpfile" 2>/dev/null || true
    mv -f "$tmpfile" "$file" 2>/dev/null || rm -f "$tmpfile" 2>/dev/null || true
  fi
  return 0
}

# ------------------------------------------------------------------------------
# Screen Guard: lock-state detection and locked-insertion audit log
# ------------------------------------------------------------------------------

ug_runtime_dir() {
  local uid base owner
  uid="$(id -u)"
  base="/run/user/${uid}"
  if [[ ! -d "$base" || -L "$base" ]]; then
    base="${XDG_RUNTIME_DIR:-}"
  fi
  if [[ -z "$base" || ! -d "$base" || -L "$base" ]]; then
    return 1
  fi
  owner="$(stat -c '%u' "$base" 2>/dev/null || echo "-1")"
  if [[ "$owner" != "$uid" ]]; then
    return 1
  fi
  printf '%s' "$base"
}

ug_locked_log_path() {
  local base
  base="$(ug_runtime_dir)" || return 1
  printf '%s' "${base}/usbguard-locked-attempts.log"
}

ug_locked_pending_path() {
  local base
  base="$(ug_runtime_dir)" || return 1
  printf '%s' "${base}/usbguard-locked-attempts.pending"
}

# True when the graphical session is locked. Checks, in order:
#   1. hyprlock / swaylock processes for this user
#   2. logind LockedHint (org.freedesktop.login1, D-Bus and loginctl)
#   3. Omarchy Quickshell lock and Hyprland ext-session-lock
# Fail-open (unlocked) if every probe is unavailable or times out.
ug_is_screen_locked() {
  local uid
  uid="$(id -u)"

  if pgrep -x -u "$uid" hyprlock >/dev/null 2>&1; then
    return 0
  fi
  if pgrep -x -u "$uid" swaylock >/dev/null 2>&1; then
    return 0
  fi

  local dbus_out=""
  if command -v busctl >/dev/null 2>&1; then
    dbus_out="$(busctl --system get-property org.freedesktop.login1 \
      /org/freedesktop/login1/session/auto \
      org.freedesktop.login1.Session LockedHint 2>/dev/null || true)"
    if [[ "$dbus_out" == *'b true'* ]]; then
      return 0
    fi
  fi

  local hint=""
  if command -v loginctl >/dev/null 2>&1 && [[ -n "${XDG_SESSION_ID:-}" ]]; then
    hint="$(loginctl show-session "$XDG_SESSION_ID" -p LockedHint --value 2>/dev/null || true)"
    if [[ "$hint" == "yes" ]]; then
      return 0
    fi
  fi

  # Omarchy's default locker is Quickshell (omarchy-shell lock), not hyprlock.
  # It uses ext-session-lock and may not set logind LockedHint.
  local reply=""
  if command -v omarchy-shell >/dev/null 2>&1; then
    reply="$(timeout --kill-after=0.1s 0.5s omarchy-shell lock isLocked 2>/dev/null || true)"
    if [[ "$reply" == "true" ]]; then
      return 0
    fi
  fi

  if command -v omarchy-hyprland-session-locked >/dev/null 2>&1; then
    if timeout --kill-after=0.1s 0.5s omarchy-hyprland-session-locked >/dev/null 2>&1; then
      return 0
    fi
  fi

  return 1
}

ug_append_secure_line() {
  local file="$1" line="$2"
  local uid owner dir old_umask
  uid="$(id -u)"
  dir="$(dirname "$file")"

  if [[ -L "$dir" || -L "$file" ]]; then
    return 1
  fi
  if [[ ! -d "$dir" ]]; then
    return 1
  fi
  owner="$(stat -c '%u' "$dir" 2>/dev/null || echo "-1")"
  [[ "$owner" == "$uid" ]] || return 1

  if [[ -f "$file" ]]; then
    owner="$(stat -c '%u' "$file" 2>/dev/null || echo "-1")"
    [[ "$owner" == "$uid" ]] || return 1
  fi

  old_umask="$(umask)"
  umask 077
  if ! printf '%s\n' "$line" >>"$file" 2>/dev/null; then
    umask "$old_umask"
    return 1
  fi
  umask "$old_umask"
  chmod 0600 "$file" 2>/dev/null || true
}

ug_rotate_if_huge() {
  local file="$1" max_bytes="${2:-131072}" keep_lines="${3:-200}"
  local sz owner uid tmp
  uid="$(id -u)"
  [[ -f "$file" && ! -L "$file" ]] || return 0
  owner="$(stat -c '%u' "$file" 2>/dev/null || echo "-1")"
  [[ "$owner" == "$uid" ]] || return 0
  sz="$(stat -c '%s' "$file" 2>/dev/null || echo 0)"
  [[ "$sz" =~ ^[0-9]+$ ]] || return 0
  ((sz > max_bytes)) || return 0
  tmp="${file}.tmp.$$"
  if tail -n "$keep_lines" "$file" >"$tmp" 2>/dev/null; then
    chmod 0600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
  else
    rm -f "$tmp" 2>/dev/null || true
  fi
}

# Append one locked-insertion record to the audit log and the pending-alert file.
# Usage: ug_log_locked_attempt id vidpid name target hash ifaces connect [combo]
ug_log_locked_attempt() {
  local id="${1-}" vidpid="${2-}" name="${3-}" target="${4-}"
  local hash="${5-}" ifaces="${6-}" connect="${7-}" combo="${8:-single}"
  local log pending ts line

  id="$(ug_sanitize "$id" 16)"
  vidpid="$(ug_sanitize "$vidpid" 16)"
  name="$(ug_sanitize "$name" 64)"
  target="$(ug_sanitize "$target" 16)"
  hash="$(ug_sanitize "$hash" 64)"
  ifaces="$(ug_sanitize "$ifaces" 48)"
  connect="$(ug_sanitize "$connect" 24)"
  combo="$(ug_sanitize "$combo" 16)"

  [[ -n "$name" ]] || name="USB device"
  [[ -n "$vidpid" ]] || vidpid="unknown"
  [[ -n "$id" ]] || id="?"

  ts="$(date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S')"
  line="${ts} id=${id} vidpid=${vidpid} target=${target} combo=${combo} connect=${connect} ifaces=${ifaces} hash=${hash} name=${name}"

  log="$(ug_locked_log_path 2>/dev/null || true)"
  pending="$(ug_locked_pending_path 2>/dev/null || true)"
  if [[ -n "$log" ]]; then
    ug_rotate_if_huge "$log" || true
    ug_append_secure_line "$log" "$line" || true
  fi
  if [[ -n "$pending" ]]; then
    ug_append_secure_line "$pending" "$line" || true
  fi
}

# Notify about devices rejected while the session was locked, then clear pending.
ug_flush_locked_attempts() {
  if ug_is_screen_locked; then
    return 0
  fi

  local pending uid owner
  pending="$(ug_locked_pending_path 2>/dev/null || true)"
  [[ -n "$pending" && -f "$pending" && ! -L "$pending" ]] || return 0

  uid="$(id -u)"
  owner="$(stat -c '%u' "$pending" 2>/dev/null || echo "-1")"
  [[ "$owner" == "$uid" ]] || return 0

  local count=0
  local summary=""
  local line name vidpid shown=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    count=$((count + 1))
    if ((shown < 5)); then
      name="${line#* name=}"
      [[ "$name" == "$line" ]] && name="USB device"
      vidpid=""
      if [[ "$line" =~ vidpid=([^[:space:]]+) ]]; then
        vidpid="${BASH_REMATCH[1]}"
      fi
      if [[ -n "$summary" ]]; then
        summary+=$'\n'
      fi
      if [[ -n "$vidpid" && "$vidpid" != "unknown" ]]; then
        summary+="${name} (${vidpid})"
      else
        summary+="${name}"
      fi
      shown=$((shown + 1))
    fi
  done <"$pending"

  if ((count <= 0)); then
    rm -f "$pending" 2>/dev/null || true
    return 0
  fi

  local extra=""
  if ((count > shown)); then
    extra=$'\n'"… and $((count - shown)) more"
  fi

  local noun="device"
  ((count == 1)) || noun="devices"

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send \
      -r 9878 \
      -g "󰌾" \
      -u critical \
      --app-name "USBGuard" \
      "USB blocked while locked" \
      "${count} ${noun} rejected while the screen was locked."$'\n'"${summary}${extra}" || true
  fi

  rm -f "$pending" 2>/dev/null || true
}


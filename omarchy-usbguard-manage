#!/bin/bash
# omarchy:summary=Zero-friction manager to review and revoke trusted USB devices via Quickshell Menu
# omarchy:args=[target-device-hash]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_SCRIPT="${SCRIPT_DIR}/backend.py"

target_hash="${1:-}"

# Fast sysfs lookup for manufacturer / product without forking lsusb
resolve_name() {
  local target_vp="${1,,}"
  local raw="$2"

  if [[ -f "$BACKEND_SCRIPT" ]] && command -v python3 &>/dev/null && [[ -n "$target_vp" ]]; then
    local res
    res=$(python3 "$BACKEND_SCRIPT" --resolve "$target_vp" "$raw" 2>/dev/null || true)
    if [[ -n "$res" ]]; then
      echo "$res"
      return
    fi
  fi

  if [[ -n "$target_vp" ]]; then
    local target_vid="${target_vp%%:*}"
    local target_pid="${target_vp##*:}"
    for dev_dir in /sys/bus/usb/devices/*; do
      if [[ -f "${dev_dir}/idVendor" && -f "${dev_dir}/idProduct" ]]; then
        local v p mfg="" prod=""
        v=$(cat "${dev_dir}/idVendor" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)
        p=$(cat "${dev_dir}/idProduct" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)
        if [[ "$v" == "$target_vid" && "$p" == "$target_pid" ]]; then
          [[ -f "${dev_dir}/manufacturer" ]] && mfg=$(cat "${dev_dir}/manufacturer" 2>/dev/null || true)
          [[ -f "${dev_dir}/product" ]] && prod=$(cat "${dev_dir}/product" 2>/dev/null || true)
          if [[ -n "$mfg" && -n "$prod" && "$mfg" != "$prod" ]]; then
            echo "${mfg} ${prod}"
            return
          elif [[ -n "$prod" ]]; then
            echo "$prod"
            return
          elif [[ -n "$mfg" ]]; then
            echo "${mfg} Device"
            return
          fi
        fi
      fi
    done
  fi

  echo "${raw:-USB Device (${target_vp})}"
}

# If invoked for a specific connected device hash
if [[ -n "$target_hash" ]]; then
  # Find rule matching target hash
  rule_line=$(usbguard list-rules 2>/dev/null | grep -F "hash \"$target_hash\"" | head -n1 || true)
  
  if [[ -z "$rule_line" ]]; then
    omarchy-notification-send \
      -u low \
      -g "󰌾" \
      --app-name "USBGuard" \
      "Device Not in Whitelist" \
      "This device is currently authorized for this session only."
    exit 0
  fi

  rule_id=$(printf '%s' "$rule_line" | cut -d':' -f1 | tr -d '[:space:]')
  vid_pid=""
  raw_name=""
  if [[ "$rule_line" =~ id\ ([0-9a-fA-F]{4}:[0-9a-fA-F]{4}) ]]; then
    vid_pid="${BASH_REMATCH[1]}"
  fi
  if [[ "$rule_line" =~ name\ \"([^\"]+)\" ]]; then
    raw_name="${BASH_REMATCH[1]}"
  fi

  display_name=$(resolve_name "$vid_pid" "$raw_name")

  opt_revoke=$'󰅙\tRevoke permanent trust\tRemove device signature from whitelist'
  opt_block=$'󰌾\tBlock for this session\tKeep device blocked until unplugged'
  opt_keep=$'\tKeep trusted\tMake no changes'

  chosen=$(omarchy-menu-select "Manage: $display_name" \
    "$opt_revoke" \
    "$opt_block" \
    "$opt_keep" \
    -- --width 580 2>/dev/null || true)

  case "$chosen" in
  *"Revoke permanent trust"*)
    usbguard remove-rule "$rule_id"
    # Find currently connected device ID matching hash and block it
    active_dev_id=$(usbguard list-devices 2>/dev/null | grep -F "hash \"$target_hash\"" | cut -d':' -f1 | head -n1 || true)
    if [[ -n "$active_dev_id" ]]; then
      usbguard block-device "$active_dev_id" 2>/dev/null || true
    fi
    omarchy-notification-send \
      -g "󰅙" \
      -u normal \
      --app-name "USBGuard" \
      "Trust Revoked" \
      "$display_name was removed from the whitelist."
    ;;
  *"Block for this session"*)
    active_dev_id=$(usbguard list-devices 2>/dev/null | grep -F "hash \"$target_hash\"" | cut -d':' -f1 | head -n1 || true)
    if [[ -n "$active_dev_id" ]]; then
      usbguard block-device "$active_dev_id" 2>/dev/null || true
    fi
    omarchy-notification-send \
      -g "󰌾" \
      -u low \
      --app-name "USBGuard" \
      "USB Device Blocked" \
      "$display_name blocked for this session."
    ;;
  esac
  exit 0
fi

# General Manager: List all whitelisted devices
menu_options=()
declare -A rule_map

while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  
  # Skip controllers and hardwired baseline
  if [[ "$line" =~ "Host Controller" ]] || [[ "$line" =~ with-connect-type\ \"hardwired\" ]]; then
    continue
  fi

  rule_id=$(printf '%s' "$line" | cut -d':' -f1 | tr -d '[:space:]')
  vid_pid=""
  raw_name=""
  rule_hash=""
  
  if [[ "$line" =~ id\ ([0-9a-fA-F]{4}:[0-9a-fA-F]{4}) ]]; then
    vid_pid="${BASH_REMATCH[1]}"
  fi
  if [[ "$line" =~ name\ \"([^\"]+)\" ]]; then
    raw_name="${BASH_REMATCH[1]}"
  fi
  if [[ "$line" =~ hash\ \"([^\"]+)\" ]]; then
    rule_hash="${BASH_REMATCH[1]}"
  fi

  d_name=$(resolve_name "$vid_pid" "$raw_name")
  
  opt_label="Revoke #${rule_id}: ${d_name}"
  opt_entry="󰅙"$'\t'"${opt_label}"$'\t'"ID: ${vid_pid:-Unknown}${rule_hash:+ · Hash: ${rule_hash:0:8}…}"
  menu_options+=("$opt_entry")
  rule_map["$opt_label"]="$rule_id|$rule_hash|$d_name"
done < <(usbguard list-rules 2>/dev/null)

if (( ${#menu_options[@]} == 0 )); then
  omarchy-notification-send \
    -u low \
    -g "󰌾" \
    --app-name "USBGuard" \
    "No Trusted Devices" \
    "Your whitelist contains only native baseline hardware."
  exit 0
fi

chosen=$(omarchy-menu-select "Revoke Trusted USB Devices" \
  "${menu_options[@]}" \
  -- --width 600 2>/dev/null || true)

if [[ -n "$chosen" ]]; then
  selected_label=$(printf '%s' "$chosen" | cut -d$'\t' -f1)
  data="${rule_map["$selected_label"]:-}"
  
  if [[ -n "$data" ]]; then
    r_id=$(printf '%s' "$data" | cut -d'|' -f1)
    r_hash=$(printf '%s' "$data" | cut -d'|' -f2)
    dev_title=$(printf '%s' "$data" | cut -d'|' -f3)

    usbguard remove-rule "$r_id"
    
    if [[ -n "$r_hash" ]]; then
      active_id=$(usbguard list-devices 2>/dev/null | grep -F "hash \"$r_hash\"" | cut -d':' -f1 | head -n1 || true)
      if [[ -n "$active_id" ]]; then
        usbguard block-device "$active_id" 2>/dev/null || true
      fi
    fi

    omarchy-notification-send \
      -g "󰅙" \
      -u normal \
      --app-name "USBGuard" \
      "Trust Revoked" \
      "$dev_title was removed from the whitelist."
  fi
fi

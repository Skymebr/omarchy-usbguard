#!/bin/bash
# omarchy:summary=Per-event handler invoked by usbguard watch -w -e
# Receives: USBGUARD_DEVICE_ID, USBGUARD_DEVICE_EVENT, USBGUARD_DEVICE_TARGET, USBGUARD_DEVICE_RULE

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_SCRIPT="${SCRIPT_DIR}/backend.py"

event="${USBGUARD_DEVICE_EVENT:-}"
dev_id="${USBGUARD_DEVICE_ID:-}"
target="${USBGUARD_DEVICE_TARGET:-}"
rule="${USBGUARD_DEVICE_RULE:-}"

if [[ -z "$event" || -z "$dev_id" ]]; then
  exit 0
fi

# 1. Sanitize attacker-controlled strings (strip control chars, collapse spaces, remove leading hyphens)
sanitize_str() {
  local raw="$1"
  local max="${2:-64}"
  local clean
  clean=$(printf '%s' "$raw" | tr -d '\000-\037\177' | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//; s/^-+//')
  if (( ${#clean} > max )); then
    clean="${clean:0:max-1}…"
  fi
  printf '%s' "$clean"
}

# 2. Extract fields from device rule
vid_pid=""
raw_name=""
dev_serial=""
dev_hash=""
dev_ifaces=""
dev_connect_type=""

if [[ "$rule" =~ id\ ([0-9a-fA-F]{4}:[0-9a-fA-F]{4}) ]]; then
  vid_pid="${BASH_REMATCH[1]}"
fi
if [[ "$rule" =~ name\ \"([^\"]+)\" ]]; then
  raw_name="${BASH_REMATCH[1]}"
fi
if [[ "$rule" =~ serial\ \"([^\"]+)\" ]]; then
  dev_serial="${BASH_REMATCH[1]}"
fi
if [[ "$rule" =~ hash\ \"([^\"]+)\" ]]; then
  dev_hash="${BASH_REMATCH[1]}"
fi
if [[ "$rule" =~ with-interface\ (\{[^\}]+\}|[0-9a-fA-F:]+) ]]; then
  dev_ifaces="${BASH_REMATCH[1]}"
fi
if [[ "$rule" =~ with-connect-type\ \"([^\"]*)\" ]]; then
  dev_connect_type="${BASH_REMATCH[1]}"
fi

# 3. Fast sysfs lookup for manufacturer / product without forking lsusb
resolve_from_sysfs() {
  local target_vp="${1,,}"
  local fallback="$2"

  if [[ -z "$target_vp" ]]; then
    echo "$fallback"
    return
  fi

  local target_vid="${target_vp%%:*}"
  local target_pid="${target_vp##*:}"

  for dev_dir in /sys/bus/usb/devices/*; do
    if [[ -f "${dev_dir}/idVendor" && -f "${dev_dir}/idProduct" ]]; then
      local v p mfg="" prod=""
      v=$(cat "${dev_dir}/idVendor" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)
      p=$(cat "${dev_dir}/idProduct" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)

      if [[ "$v" == "$target_vid" && "$p" == "$target_pid" ]]; then
        [[ -f "${dev_dir}/manufacturer" ]] && mfg=$(cat "${dev_dir}/manufacturer" 2>/dev/null || true)
        [[ -f "${dev_dir}/product" ]] && prod=$(cat "${dev_dir}/product" 2>/dev/null || true)
        mfg=$(sanitize_str "$mfg" 32)
        prod=$(sanitize_str "$prod" 32)

        if [[ -n "$mfg" && -n "$prod" && "$mfg" != "$prod" ]]; then
          echo "${mfg} ${prod}"
          return
        elif [[ -n "$prod" ]]; then
          echo "$prod"
          return
        elif [[ -n "$mfg" ]]; then
          echo "${mfg} Device"
          return
        fi
      fi
    fi
  done

  echo "${fallback:-USB Device (${target_vp})}"
}

# 4. Centralized Classification (using backend.py with fallback)
dev_type="USB Peripheral"
glyph="󰚥"
urgency="normal"
is_combo="single"
clean_name=""

if [[ -f "$BACKEND_SCRIPT" ]] && command -v python3 &>/dev/null; then
  class_output=$(python3 "$BACKEND_SCRIPT" --classify "$dev_ifaces" "$raw_name" "$vid_pid" "$dev_connect_type" 2>/dev/null || true)
  if [[ -n "$class_output" && "$class_output" == *"|"* ]]; then
    dev_type=$(printf '%s' "$class_output" | cut -d'|' -f1)
    glyph=$(printf '%s' "$class_output" | cut -d'|' -f2)
    urgency=$(printf '%s' "$class_output" | cut -d'|' -f3)
    is_combo=$(printf '%s' "$class_output" | cut -d'|' -f5)
    clean_name=$(printf '%s' "$class_output" | cut -d'|' -f6)
  fi
fi

if [[ -z "$clean_name" ]]; then
  raw_display=$(resolve_from_sysfs "$vid_pid" "$raw_name")
  clean_name=$(sanitize_str "$raw_display" 64)

  # Pure bash fallback
  has_storage=0; has_hid=0; has_net=0; is_kbd=0; is_mouse=0
  if [[ "$dev_ifaces" =~ (^|[[:space:]\{])08: ]]; then has_storage=1; fi
  if [[ "$dev_ifaces" =~ (^|[[:space:]\{])03:01:01 ]]; then is_kbd=1; has_hid=1; fi
  if [[ "$dev_ifaces" =~ (^|[[:space:]\{])03:01:02 ]]; then is_mouse=1; has_hid=1; fi
  if [[ "$dev_ifaces" =~ (^|[[:space:]\{])03: ]]; then has_hid=1; fi
  if [[ "$dev_ifaces" =~ (^|[[:space:]\{])(02:|0a:) ]]; then has_net=1; fi

  if (( has_storage && (has_hid || has_net) )); then
    dev_type="⚠️ High-Risk BadUSB"
    glyph="󰕤"
    urgency="critical"
    is_combo="combo"
  elif (( is_kbd )); then
    dev_type="USB Keyboard"; glyph="󰌌"; urgency="normal"
  elif (( is_mouse )); then
    dev_type="USB Mouse"; glyph="󰍽"; urgency="normal"
  elif (( has_storage )); then
    dev_type="Mass Storage"; glyph="󰕒"; urgency="normal"
  elif [[ "$dev_ifaces" =~ (^|[[:space:]\{])01: ]]; then
    dev_type="Audio Device"; glyph="󰓗"; urgency="normal"
  elif [[ "$dev_ifaces" =~ (^|[[:space:]\{])(0e:|10:) ]]; then
    dev_type="Camera / Video"; glyph="󰄀"; urgency="normal"
  elif (( has_net )); then
    dev_type="Network Adapter"; glyph="󰖩"; urgency="normal"
  elif [[ "$dev_ifaces" =~ (^|[[:space:]\{])e0: ]]; then
    dev_type="Bluetooth Radio"; glyph="󰂯"; urgency="normal"
  elif [[ "$dev_ifaces" =~ (^|[[:space:]\{])09: ]]; then
    dev_type="USB Hub"; glyph="󰕓"; urgency="low"
  fi
fi

# 5. Generate distinct replace_id per device hash to prevent notification collisions
rep_id=9876
if [[ -n "$dev_hash" ]]; then
  hex_hash=$(printf '%s' "$dev_hash" | sha256sum | cut -c1-6)
  rep_id=$(( 1000 + ( 16#${hex_hash} % 80000 ) ))
else
  rep_id=$(( 1000 + ( dev_id % 1000 ) ))
fi

# 6. Event Handling
case "$event" in
Insert|Update)
  if [[ "$target" == "allow" ]]; then
    # Device matched an existing allow policy rule (Click to revoke or manage)
    omarchy-notification-send \
      -r "$rep_id" \
      -g "$glyph" \
      -u low \
      -t 4000 \
      --app-name "USBGuard" \
      "USB Device Connected" \
      "${clean_name} · ${dev_type}"$'\n'"Click to manage or revoke trust." \
      --exec omarchy-usbguard-manage "${dev_hash:-}" || true
  elif [[ "$target" == "block" || "$target" == "reject" ]]; then
    # Short wait for policy evaluation to avoid transient probe race
    sleep 0.08
    active_target=$(usbguard list-devices 2>/dev/null | grep -E "^${dev_id}:" | awk '{print $2}' || true)
    
    if [[ "$active_target" == "allow" ]]; then
      # Policy immediately matched and allowed the device
      omarchy-notification-send \
        -r "$rep_id" \
        -g "$glyph" \
        -u low \
        -t 4000 \
        --app-name "USBGuard" \
        "USB Device Connected" \
        "${clean_name} · ${dev_type}"$'\n'"Click to manage or revoke trust." \
        --exec omarchy-usbguard-manage "${dev_hash:-}" || true
    else
      headline="USB Device Blocked"
      body_text="${clean_name} · ${dev_type}"$'\n'"Click to manage authorization."

      if [[ "$is_combo" == "combo" ]]; then
        headline="⚠️ High-Risk Device Blocked"
        body_text="${clean_name} claims to be both Storage and Keyboard/Network."$'\n'"Click to inspect or reject."
      fi

      omarchy-notification-send \
        -r "$rep_id" \
        -g "$glyph" \
        -u "$urgency" \
        --app-name "USBGuard" \
        "$headline" \
        "$body_text" \
        --exec omarchy-usbguard-prompt "$dev_id" "${dev_hash:-nohash}" "$clean_name" "$dev_type" "$is_combo" || true
    fi
  fi
  ;;
Remove)
  # Low-urgency disconnect toast, replaces any pending blocked notification for this device
  omarchy-notification-send \
    -r "$rep_id" \
    -g "$glyph" \
    -u low \
    -t 3000 \
    --app-name "USBGuard" \
    "USB Device Disconnected" \
    "${clean_name} · ${dev_type}" || true
  ;;
esac
